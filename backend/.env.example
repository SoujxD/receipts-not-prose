# Copy to backend/.env and fill in. backend/.env is git-ignored and excluded from the submission.
OPENAI_API_KEY=your-key-here
# Optional: defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# Optional: defaults to sqlite+aiosqlite:///./dev.db (also used by alembic)
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
